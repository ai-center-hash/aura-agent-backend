            }
          ]
        },
        {
          "name": "Ask FREYA — stream (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "stream"
              ]
            },
            "description": "เหมือน `POST /api/chat` แต่ตอบเป็น Server-Sent Events\n\n| event | data |\n|---|---|\n| `status` | `{type, text}` agent กำลังเรียกเครื่องมือ เช่น \"กำลังดูผลการเรียน...\" |\n| `delta` | `{type, content}` ข้อความทีละชิ้น ต่อกันตามลำดับ (Markdown) |\n| `done` | `{type, session_id, message_id, agent, acting_as, tools_used, latency_ms, usage}` |\n| `error` | `{message, code}` (ส่งแทน `done`, HTTP 200) |\n\nการตรวจสิทธิ์ห้องและ agent (404 / 422) ทำก่อนเริ่ม stream",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"ตรวจสอบจบให้หน่อย\",\n  \"agent\": \"freya\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agent mismatch → 422",
          "request": {
